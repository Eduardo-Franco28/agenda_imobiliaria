# Copie para .env.local (uso com `vercel dev`) e configure os mesmos valores
# em Vercel > Project > Settings > Environment Variables.

# Projeto Supabase "agenda-imobiliaria" (ref yuojxbeakhfnlvefzoro), sa-east-1
SUPABASE_URL=https://yuojxbeakhfnlvefzoro.supabase.co

# Chave service_role (SECRETA) — copie em:
# https://supabase.com/dashboard/project/yuojxbeakhfnlvefzoro/settings/api-keys
# Nunca coloque esta chave no HTML/JS do navegador nem em um commit.
SUPABASE_SERVICE_ROLE_KEY=
